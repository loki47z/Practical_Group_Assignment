<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product</title>
    <style>
        *{
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }
        body{
            background-color: #f0f0f0;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            min-height: 100vh;
            flex-direction: column;
        }
        h2{
            text-align: center;
            margin: 1rem 0;
        }
        form{
            width: 50%;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            gap: 2px;
        }
        input[type="text"],
        input[type="number"], select {
            width: 100%;
            padding: 10px;
            margin: 5px 0;
            border: 1px solid #ccc;
            border-radius: 4px;
        }
        button{
            background-color: #1c1cbb;
            color: white;
            padding: 10px 20px;
            border: none;
            border-radius: 4px;
            cursor: pointer;
            width: 100%;
        }
    </style>
</head>
<body>
    <h2>Edit Product</h2>
    <form method="POST" action="/products/edit/<%= product.Id %>">
        <label for="ProductName">Product Name</label>
        <input type="text" name="productName" value="<%= product.Name %>" required /><br>

        <label for="Category">Category</label>
        <select id="Category" name="category" required><br>
            <option value="Electronics">Electronics</option>
            <option value="Beverages">Beverages</option><br>
            <option value="Households">Households</option><br>
            <option value="Toiletries">Toiletries</option><br>
            <option value="Clothing">Clothing</option><br>
            <option value="Stationary">Stationary</option><br>
            <option value="Automotive">Automotive</option><br>
            <option value="Hardware">Hardware</option><br>
        </select><br>

        <label for="Quantity">Quantity</label>
        <input type="number" name="quantity" value="<%= product.Quantity %>" required /><br>
        <label for="Price">Price</label>
        <input type="number" name="price" value="<%= product.Price %>" required /><br>
        <button type="submit">Update</button>
    </form>
</body>
</html>