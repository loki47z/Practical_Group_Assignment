<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <title>Dashboard</title>
  <style>
    *{
        margin: 0;
        padding: 0;
        box-sizing: border-box;
    }
    
    body{
        background-color: #f0f0f0;
        font-family: Arial, sans-serif;
    }
    
    .nav-bar {
        background-color: #1c1cbb;
        color: white;
    }
    
    .nav-bar ul {
        list-style: none;
        padding: 0;
        display: flex;
        flex-direction: row;
        justify-content: space-between;
        align-items: center;
    }
    
    .nav-bar li {
        display: inline;
        margin: 0;
        transition: background-color 0.3s;
        padding: 16px;
    }
    
    .nav-bar a {
        color: white;
        text-decoration: none;
    }
    .nav-bar li:hover {
        background-color: #575757;
    }
  </style>
</head>
<body>

    <nav class="nav-bar">
        <ul>
          <div>
            <li><a href="/home">Home</a></li>
            <li><a href="/products/view">Products</a></li>
            <li><a href="/products/add">New Products</a></li>
            <li><a href="#">Dashboard</a></li>
          </div>
          <li class="logout-btn"><a href="/">Logout</a></li>
        </ul>
      </nav>

    <canvas id="myChart" style="width:100%;max-width:600px"></canvas>
    <canvas id="myChart2" style="width:100%;max-width:600px"></canvas>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/2.9.4/Chart.js"></script>
    <script>
        fetch('data.json')
        .then(response => response.json())
        .then(products => {
            const categoryCounts = products.reduce((acc, product) => {
            const category = product.Category;
            acc[category] = (acc[category] || 0) + 1;
            return acc;
            }, {});

            const xValues = Object.keys(categoryCounts);
            const yValues = Object.values(categoryCounts);
            const barColors = ["blue", "orange", "red", "green", "yellow", "purple", "pink", "brown"];

            new Chart("myChart", {
            type: "bar",
            data: {
                labels: xValues,
                datasets: [{
                backgroundColor: barColors,
                data: yValues
                }]
            },
            options: {
                legend: { display: false },
                title: {
                display: true,
                text: "Products by Category"
                },
                scales: {
                yAxes: [{
                    ticks: {
                    beginAtZero: true,
                    precision: 0
                    }
                }]
                }
            }
            });
            new Chart("myChart2", {
            type: "pie",
            data: {
                labels: xValues,
                datasets: [{
                backgroundColor: barColors,
                data: yValues
                }]
            },
            options: {
                title: {
                display: true,
                text: "Products by Category (Pie)"
                }
            }
            });
        })
        .catch(error => console.error('Error loading data:', error));
    </script>
</body>
</html>
