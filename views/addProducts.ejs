<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Products</title>
  <style>
  *{
      margin: 0;
      padding: 0;
      box-sizing: border-box;
  }
  
  body{
      background-color: #f0f0f0;
      font-family: Arial, sans-serif;
  }
  
  .nav-bar {
      background-color: #1c1cbb;
      color: white;
  }
  
  .nav-bar ul {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
  }
  
  .nav-bar li {
      display: inline;
      margin: 0;
      transition: background-color 0.3s;
      padding: 16px;
  }
  
  .nav-bar a {
      color: white;
      text-decoration: none;
  }
  .nav-bar li:hover {
      background-color: #575757;
  }
  form{
      margin: 20px;
      padding: 20px;
      border-radius: 5px;
  }
  .para{
    font-size: 2rem;
    margin-bottom: 6px;
  }
  </style>
</head>
<body>
  <nav class="nav-bar">
    <ul>
      <div>
        <li><a href="/home">Home</a></li>
        <li><a href="/products/view">Products</a></li>
        <li><a href="#">New Products</a></li>
        <li><a href="/dashboard">Dashboard</a></li>
      </div>
      <li class="logout-btn"><a href="/">Logout</a></li>
    </ul>
  </nav>

  <div>
    <form method="POST" action="/products/add">
      <p class="para">New Product</p>
      <label for="Produt-Name">Product Name</label><br>
      <input type="Text" id="productName" name= "productName" required><br>
    
      
      <label for="Category">Category</label><br>
      <select id="Category" name="category" required><br>
      <option value="Electronics">Electronics</option>
      <option value="Beverages">Beverages</option><br>
      <option value="Households">Households</option><br>
      <option value="Toiletries">Toiletries</option><br>
      <option value="Clothing">Clothing</option><br>
      <option value="Stationary">Stationary</option><br>
      <option value="Automotive">Automotive</option><br>
      <option value="Hardware">Hardware</option><br>
      </select><br>
     
    
      <label for="Quantity">Quantity</label><br>
      <input type="number" id="Quantity" name ="quantity" required><br>

      <label for="Price">Price</label><br>
      <input type="Text" id="price" name="price" required><br>

      <button class="btn">Send</button>
      
    </form>

    
  </div>
  
</body>
</html>