<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Product Catalogue</title>
  <style>
    *{
      margin: 0;
      padding: 0;
      box-sizing: border-box;
  }
  
  body{
      background-color: #f0f0f0;
      font-family: Arial, sans-serif;
  }
  
  .nav-bar {
      background-color: #1c1cbb;
      color: white;
  }
  
  .nav-bar ul {
      list-style: none;
      padding: 0;
      display: flex;
      flex-direction: row;
      justify-content: space-between;
      align-items: center;
  }
  
  .nav-bar li {
      display: inline;
      margin: 0;
      transition: background-color 0.3s;
      padding: 16px;
  }
  
  .nav-bar a {
      color: white;
      text-decoration: none;
  }
  .nav-bar li:hover {
      background-color: #575757;
  }
  table{
      margin: 20px;
      padding: 20px;
      border-radius: 5px;
      width: 90%;
      border-collapse: collapse;
  }
  th, td {
      border-bottom: 2px solid #ddd;
      padding: 8px;
      text-align: left;
  }
  h2 {
      margin: 20px;
      font-size: 2rem;
  }
  button{
      margin: 20px;
      padding: 10px 20px;
      background-color: #1c1cbb;
      color: white;
      border: none;
      border-radius: 5px;
      cursor: pointer;
  }
  button > a{
      color: white;
      text-decoration: none;
  }
  </style>
</head>
<body>
  <nav class="nav-bar">
    <ul>
      <div>
        <li><a href="/home">Home</a></li>
        <li><a href="#">Products</a></li>
        <li><a href="/products/add">New Products</a></li>
        <li><a href="/dashboard">Dashboard</a></li>
      </div>

      <li class="logout-btn"><a href="/
        ">Logout</a></li>
    </ul>
  </nav>

  <div>
    <h2>Products Catalogue</h2>

    <div>
      <table>
        <tr>
          <th>Id</th>
          <th>Name</th>
          <th>Category</th>
          <th>Quantity</th>
          <th>Price</th>
          <th></th>
          <th></th>
        </tr>
        <% for(let i = 0; i < jsonProducts.length; i++) { %>
            <tr>
                <td><%= jsonProducts[i].Id %></td>
                <td><%= jsonProducts[i].Name %></td>
                <td><%= jsonProducts[i].Category %></td>
                <td><%= jsonProducts[i].Quantity %></td>
                <td><%= jsonProducts[i].Price %></td>
                <td><a href="/products/edit/<%= jsonProducts[i].Id %>">Edit</a></td>
                <td><a href="/products/delete/<%= jsonProducts[i].Id %>">Delete</a></td>
            </tr>
        <% } %>
      </table>
      <button>
        <a href="/products/add">Add Product</a>
      </button>
    </div>
    
  </div>

  </body>
  </html>