<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>New Products</title>
  <link rel="stylesheet" href="styles.css">
</head>
<body>
  <nav class="nav-bar">
    <ul>
      <div>
        <li><a href="home.html">Home</a></li>
        <li><a href="products.html">products</a></li>
        <li><a href="newProducts.html">New Products</a></li>
        <li><a href="dashboard.html">Dashboard</a></li>
      </div>

      <li class="logout-btn"><a href="logout.html">logout</a></li>
    </ul>
  </nav>

  <div>
    <h2>Products Catalogue</h2>

    <div>
      <table>
        <tr>
          <th>Id</th>
          <th>Name</th>
          <th>Category</th>
          <th>Quantity</th>
          <th>Price</th>
        </tr>
        <% for(let i = 0; i < jsonProducts.length; i++) { %>
            <tr>
                <td><%= jsonProducts[i].Id %></td>
                <td><%= jsonProducts[i].Name %></td>
                <td><%= jsonProducts[i].Category %></td>
                <td><%= jsonProducts[i].Quantity %></td>
                <td><%= jsonProducts[i].Price %></td>
                <td><a href="#edit">Edit</a></td>
                <td><a href="#delete">Delete</a></td>
            </tr>
        <% } %>
      </table>
      <button>
        <a href="/products/add">Add Product</a>
      </button>
    </div>
    
  </div>

  </body>
  </html>